# dnscrypt-proxy 2.1.18 — app-managed config (materialized from template by apply.sh)
listen_addresses = ['127.0.0.1:5335']
ignore_system_dns = true
netprobe_timeout = 0
log_level = 2
log_file = '@STATE@/filter.log'
log_file_latest = true
cache = true
user_name = 'nobody'
forwarding_rules = '@STATE@/forward-rules.txt'
blocked_query_response = 'refused'
# dnscrypt-proxy REQUIRES at least one registered server OR offline_mode=true
# (forwarding rules do NOT register any server; startup hard-fails with "no
# servers were found in the configured sources" otherwise). With this setup
# queries still resolve via forwarding_rules. Do not remove - S4 T7 on-device
# finding: removing it broke apply with reason=filter-sideport on the G1.
offline_mode = true
[blocked_names]
  blocked_names_file = '@STATE@/filter-input.txt'
  log_file = '@STATE@/blocked-names.log'
