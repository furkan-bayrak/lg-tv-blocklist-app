#!/bin/sh
# Test stub for dnsq (driven via LGTVB_DNSQ). Exit code decided by environment:
#   TEST_DNSQ_RC         fallback rc (default 0)
#   TEST_DNSQ_NAME_RC    file of "<name-fragment> <rc>" lines — first line whose
#                        fragment is a substring of $1 (query name) wins
#   TEST_DNSQ_SERVER_RC  file of "<server> <rc>" lines — first line whose server
#                        equals $2 wins; wins over the name-file when both match
#   TEST_DNSQ_QUERY_RC   file of "<server> <name> <rc> <rcode>" exact queries,
#                        applied last; logs queries to the same path + ".log"
rc=${TEST_DNSQ_RC:-0}
if [ -n "${TEST_DNSQ_NAME_RC:-}" ] && [ -f "$TEST_DNSQ_NAME_RC" ]; then
  while read -r pat r; do
    [ -n "$pat" ] || continue
    case "$1" in *"$pat"*) rc=$r; break ;; esac
  done < "$TEST_DNSQ_NAME_RC"
fi
if [ -n "${TEST_DNSQ_SERVER_RC:-}" ] && [ -f "$TEST_DNSQ_SERVER_RC" ]; then
  while read -r pat r; do
    [ -n "$pat" ] || continue
    if [ "${2:-}" = "$pat" ]; then rc=$r; break; fi
  done < "$TEST_DNSQ_SERVER_RC"
fi
# With TEST_DNSQ_IPT_GATE, blocked queries to IPv4 loopback are REFUSED only
# while the NAT jump exists. Explicit configured-loopback probes use this too.
if [ -n "${TEST_DNSQ_IPT_GATE:-}" ] && [ "${2:-127.0.0.1}" = 127.0.0.1 ] && [ -n "${LGTVB_STATE_DIR:-}" ] && [ -n "${TEST_IPT_STATE:-}" ] && [ -f "$LGTVB_STATE_DIR/filter-input.txt" ]; then
  bn="$(grep -m1 '^=' "$LGTVB_STATE_DIR/filter-input.txt" 2>/dev/null | cut -c2-)"
  if [ -n "$bn" ]; then
    case "$1" in
      *"$bn")
        if grep -qF 'R nat OUTPUT -j LGTVBLK' "$TEST_IPT_STATE" 2>/dev/null; then rc=2; else rc=0; fi
        ;;
    esac
  fi
fi
rcode=0
[ "$rc" -ne 2 ] || rcode=5
if [ -n "${TEST_DNSQ_QUERY_RC:-}" ]; then
  printf '%s %s %s\n' "${2:-127.0.0.1}" "$1" "${3:-53}" >> "$TEST_DNSQ_QUERY_RC.log"
  if [ -f "$TEST_DNSQ_QUERY_RC" ]; then
    while read -r server name result code; do
      if [ "${2:-127.0.0.1}" = "$server" ] && [ "$1" = "$name" ]; then
        rc=$result; rcode=$code; break
      fi
    done < "$TEST_DNSQ_QUERY_RC"
  fi
fi
if [ "$rc" -eq 1 ]; then echo TIMEOUT; else echo "rcode=$rcode ancount=0 none"; fi
exit "$rc"
