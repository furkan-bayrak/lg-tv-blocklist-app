{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5", "DOM"],
    "rootDir": "src",
    "outDir": "app/js",
    "removeComments": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
